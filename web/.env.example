# Frontend build-time variables. These values are public in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://your-worker.workers.dev

# There is intentionally no VITE_GEOAPIFY_API_KEY and no service-role key.
# Geoapify and Supabase service-role credentials belong only in Worker secrets.
# Local OAuth callback: http://localhost:3000/auth/callback
# Production OAuth callback: https://your-pages-domain.example/auth/callback
